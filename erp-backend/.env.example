DATABASE_URL="postgresql://kotrim:kotrim@localhost:5432/kotrim_erp?schema=public"

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:4200

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

LOG_LEVEL=debug

# Billing (manual mode — no gateway wired up yet)
TRIAL_DURATION_DAYS=7
BILLING_PIX_KEY=
BILLING_CONTACT=

# Public base URL of the frontend — used to build links in outgoing e-mails.
APP_URL=http://localhost:4200

# ── Mail ────────────────────────────────────────────────────────────────────
# 'resend' delivers; 'console' logs and sends nothing (the default with no key).
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=Kotrim <nao-responda@seu-dominio.com.br>
# When set, every message is redirected here instead of the real recipient.
# Use it in development; leave empty in production.
MAIL_REDIRECT_TO=

# Copied on the "order received" e-mail so staff can activate a payment quickly.
MAIL_STAFF_NOTIFY_TO=
