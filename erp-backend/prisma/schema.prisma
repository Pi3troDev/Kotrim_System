// Prisma schema — Kotrim System ERP
// Multi-tenant by design: nearly every table is scoped by companyId so the
// same database can serve many workshops (companies) safely.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum WorkOrderStatus {
  OPEN
  IN_DIAGNOSIS
  WAITING_APPROVAL
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum WorkOrderItemType {
  SERVICE
  PART
}

enum CategoryType {
  INVENTORY
  EXPENSE
  INCOME
}

enum FinancialStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum AttachmentEntity {
  WORK_ORDER
  CLIENT
  VEHICLE
  EMPLOYEE
  EXPENSE
  COMPANY
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy, identity & access control
// ─────────────────────────────────────────────────────────────────────────

model Company {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  document  String // CNPJ/CPF
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users          User[]
  roles          Role[]
  clients        Client[]
  vehicles       Vehicle[]
  suppliers      Supplier[]
  employees      Employee[]
  categories     Category[]
  inventoryItems InventoryItem[]
  workOrders     WorkOrder[]
  expenses       Expense[]
  incomes        Income[]
  notifications  Notification[]
  attachments    Attachment[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]

  @@unique([document])
  @@index([deletedAt])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. "work-orders.create"
  module      String // e.g. "work-orders"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  roleId       String    @db.Uuid
  name         String
  email        String
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role           Role            @relation(fields: [roleId], references: [id])
  employee       Employee?
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  attachments    Attachment[]    @relation("AttachmentUploadedBy")
  stockMovements StockMovement[]

  @@unique([email])
  @@index([companyId])
  @@index([deletedAt])
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?   @db.Uuid
  createdByIp String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────
// People: clients, vehicles, employees
// ─────────────────────────────────────────────────────────────────────────

model Client {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  name      String
  document  String? // CPF/CNPJ
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicles   Vehicle[]
  workOrders WorkOrder[]
  incomes    Income[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([deletedAt])
}

model Vehicle {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  clientId      String    @db.Uuid
  plate         String
  brand         String
  model         String
  year          Int?
  color         String?
  chassisNumber String?
  mileage       Int?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@unique([companyId, plate])
  @@index([companyId])
  @@index([clientId])
  @@index([deletedAt])
}

model Employee {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  userId    String?   @unique @db.Uuid
  name      String
  document  String?
  position  String? // e.g. "Mecânico", "Recepcionista"
  specialty String?
  phone     String?
  email     String?
  hiredAt   DateTime?
  salary    Decimal?  @db.Decimal(12, 2)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id])
  workOrders WorkOrder[]

  @@index([companyId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Work orders — the core module
// ─────────────────────────────────────────────────────────────────────────

model WorkOrder {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @db.Uuid
  number          Int // sequential, human-friendly, unique per company
  clientId        String          @db.Uuid
  vehicleId       String          @db.Uuid
  employeeId      String?         @db.Uuid
  status          WorkOrderStatus @default(OPEN)
  reportedProblem String
  diagnosis       String?
  observations    String?
  laborAmount     Decimal         @default(0) @db.Decimal(12, 2)
  partsAmount     Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @db.Decimal(12, 2)
  warrantyDays    Int             @default(0)
  warrantyUntil   DateTime?
  openedAt        DateTime        @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client   Client             @relation(fields: [clientId], references: [id])
  vehicle  Vehicle            @relation(fields: [vehicleId], references: [id])
  employee Employee?          @relation(fields: [employeeId], references: [id])
  items    WorkOrderItem[]
  history  WorkOrderHistory[]
  incomes  Income[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([clientId])
  @@index([vehicleId])
  @@index([deletedAt])
}

model WorkOrderItem {
  id              String            @id @default(uuid()) @db.Uuid
  workOrderId     String            @db.Uuid
  inventoryItemId String?           @db.Uuid
  type            WorkOrderItemType
  description     String
  quantity        Decimal           @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal           @db.Decimal(12, 2)
  totalPrice      Decimal           @db.Decimal(12, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workOrder     WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([workOrderId])
  @@index([inventoryItemId])
}

// Full audit trail of status/observation changes for a work order.
model WorkOrderHistory {
  id          String          @id @default(uuid()) @db.Uuid
  workOrderId String          @db.Uuid
  status      WorkOrderStatus
  notes       String?
  changedById String?         @db.Uuid
  changedAt   DateTime        @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory
// ─────────────────────────────────────────────────────────────────────────

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid
  name      String
  type      CategoryType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  expenses       Expense[]
  incomes        Income[]

  @@unique([companyId, name, type])
  @@index([companyId])
}

model Supplier {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  name      String
  document  String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@index([companyId])
  @@index([deletedAt])
}

model InventoryItem {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  categoryId      String?   @db.Uuid
  supplierId      String?   @db.Uuid
  sku             String?
  name            String
  description     String?
  unit            String    @default("UN")
  costPrice       Decimal   @default(0) @db.Decimal(12, 2)
  salePrice       Decimal   @default(0) @db.Decimal(12, 2)
  quantityInStock Decimal   @default(0) @db.Decimal(10, 2)
  minimumStock    Decimal   @default(0) @db.Decimal(10, 2)
  location        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  workOrderItems WorkOrderItem[]
  stockMovements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, name])
  @@index([deletedAt])
}

// Auditable ledger of every stock change — never mutate quantityInStock directly.
model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @db.Uuid
  inventoryItemId String            @db.Uuid
  userId          String?           @db.Uuid
  type            StockMovementType
  quantity        Decimal           @db.Decimal(10, 2)
  reason          String?
  referenceId     String?           @db.Uuid // e.g. WorkOrder id
  createdAt       DateTime          @default(now())

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([inventoryItemId])
}

// ─────────────────────────────────────────────────────────────────────────
// Finance
// ─────────────────────────────────────────────────────────────────────────

model Expense {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @db.Uuid
  categoryId    String?         @db.Uuid
  description   String
  amount        Decimal         @db.Decimal(12, 2)
  status        FinancialStatus @default(PENDING)
  paymentMethod String?
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([dueDate])
  @@index([deletedAt])
}

model Income {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @db.Uuid
  categoryId    String?         @db.Uuid
  clientId      String?         @db.Uuid
  workOrderId   String?         @db.Uuid
  description   String
  amount        Decimal         @db.Decimal(12, 2)
  status        FinancialStatus @default(PENDING)
  paymentMethod String?
  dueDate       DateTime
  receivedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  Category?  @relation(fields: [categoryId], references: [id])
  client    Client?    @relation(fields: [clientId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([dueDate])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Cross-cutting: notifications, attachments, audit log
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType @default(INFO)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId, isRead])
}

// Polymorphic by convention (entityType + entityId), not by FK: Prisma has no
// native polymorphic relations, so referential integrity for entityId is
// enforced in the application/service layer rather than at the DB level.
model Attachment {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @db.Uuid
  uploadedById String?          @db.Uuid
  entityType   AttachmentEntity
  entityId     String           @db.Uuid
  fileName     String
  url          String
  mimeType     String
  size         Int
  createdAt    DateTime         @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @db.Uuid
  userId    String?     @db.Uuid
  action    AuditAction
  entity    String
  entityId  String?     @db.Uuid
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([entity, entityId])
  @@index([createdAt])
}
